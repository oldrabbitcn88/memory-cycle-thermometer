.page{padding:24rpx 20rpx 40rpx}
.center{text-align:center;padding:200rpx 40rpx}
.muted{color:#9ca3af}
.err{color:#dc2626;font-size:26rpx;word-break:break-all;white-space:pre-line;text-align:left}
.card{background:#fff;border:1rpx solid #e5e7eb;border-radius:20rpx;padding:26rpx;margin-bottom:20rpx}
.duo{display:flex;align-items:center}
.half{flex:1;text-align:center}
.vline{width:1rpx;height:120rpx;background:#e5e7eb}
.lbl{font-size:24rpx;color:#6b7280}
.big{font-size:86rpx;font-weight:800;line-height:1.1}
.u{font-size:30rpx;font-weight:400;color:#9ca3af}
.phase{font-size:26rpx;font-weight:700;margin-top:4rpx}
.row{display:flex;justify-content:space-between;align-items:center;font-size:26rpx}
.k{color:#6b7280}
.v{font-weight:600}
.v.ok{color:#16a34a}
.trig{margin-top:6rpx}
.trig view{font-size:26rpx;color:#dc2626;font-weight:600;line-height:1.7}
.anchor.warn{border-color:#fca5a5;background:#fff7f7}
.anote{font-size:23rpx;color:#6b7280;line-height:1.6;margin-top:8rpx}
.sig-head{display:flex;align-items:center;gap:16rpx}
.idx{width:52rpx;height:52rpx;border-radius:12rpx;color:#fff;font-weight:800;font-size:28rpx;
     display:flex;align-items:center;justify-content:center;flex-shrink:0}
.st{flex:1;min-width:0}
.nm{font-size:27rpx;font-weight:700}
.w{font-size:21rpx;color:#9ca3af;font-weight:400}
.stale{font-size:19rpx;color:#9ca3af;background:#f3f4f6;padding:2rpx 10rpx;border-radius:99rpx;margin-left:8rpx}
.ld{font-size:21rpx;color:#9ca3af;margin-top:2rpx}
.val{font-size:44rpx;font-weight:800}
.bar{height:10rpx;background:#eef0f3;border-radius:5rpx;overflow:hidden;margin:16rpx 0 10rpx}
.fill{height:100%;border-radius:5rpx}
.met{font-size:23rpx;color:#374151;line-height:1.6;display:flex;justify-content:space-between;align-items:baseline;gap:16rpx}
.mt{flex:1;min-width:0}
.met .q{flex-shrink:0}
.tabs{display:flex;gap:10rpx;margin-bottom:16rpx}
.tab{font-size:24rpx;padding:8rpx 22rpx;border-radius:99rpx;background:#f3f4f6;color:#6b7280}
.tab.on{background:#1a1d23;color:#fff}
.chart{width:100%;height:300rpx}
.legend{display:flex;gap:22rpx;font-size:21rpx;margin-top:8rpx}
.tip{font-size:20rpx;color:#9ca3af;margin-top:10rpx;line-height:1.6}
.src{font-size:23rpx;color:#2563eb;padding:10rpx 0;border-top:1rpx dashed #e5e7eb}
.surl{color:#9ca3af;font-size:20rpx;word-break:break-all;display:block;margin-top:2rpx}
.disc{font-size:21rpx;color:#9ca3af;line-height:1.7;padding:10rpx 16rpx 30rpx;text-align:center}

/* 单一行业温度卡 */
.temp{text-align:center}
.temp .lbl{display:flex;justify-content:center;align-items:baseline;gap:12rpx}
.q{font-size:21rpx;color:#2563eb;font-weight:400}
.scale{margin:22rpx 4rpx 0}
.sbar{position:relative;height:8rpx;border-radius:4rpx;
      background:linear-gradient(90deg,#16a34a 0%,#a3b209 38%,#d97706 68%,#dc2626 100%)}
.sdot{position:absolute;top:50%;width:22rpx;height:22rpx;margin-left:-11rpx;border-radius:50%;
      border:4rpx solid #fff;box-shadow:0 0 0 1rpx #d1d5db;transform:translateY(-50%)}
.scap{display:flex;justify-content:space-between;font-size:19rpx;color:#9ca3af;margin-top:12rpx}
.hint{font-size:22rpx;color:#6b7280;line-height:1.6;margin-top:16rpx}

/* 展开的说明区 */
.exp{margin-top:18rpx;padding-top:16rpx;border-top:1rpx dashed #e5e7eb;text-align:left}
.exp-h{font-size:21rpx;color:#9ca3af;font-weight:600;margin:14rpx 0 6rpx}
.exp-h:first-child{margin-top:0}
.exp-p{font-size:22rpx;color:#374151;line-height:1.7}
.exp-note{font-size:21rpx;color:#6b7280;line-height:1.7;margin-top:12rpx;
          background:#f9fafb;border-left:4rpx solid #e5e7eb;padding:12rpx 14rpx;border-radius:0 8rpx 8rpx 0}
.rule{display:flex;justify-content:space-between;align-items:center;font-size:22rpx;
      color:#6b7280;padding:7rpx 12rpx;border-radius:8rpx}
.rule.on{background:#eef2ff;color:#1a1d23;font-weight:700}
.rc{flex:1;min-width:0}
.rs{margin-left:16rpx;font-variant-numeric:tabular-nums}
.row.bot{margin-top:8rpx;padding-top:12rpx;border-top:1rpx dashed #e5e7eb}
.row.bot .q{margin-left:12rpx}

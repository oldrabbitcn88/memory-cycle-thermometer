<view class="page">
  <view wx:if="{{loading}}" class="center muted">加载中…</view>
  <view wx:elif="{{err}}" class="center err">{{err}}</view>
  <block wx:else>

    <view class="card temp" bindtap="toggleTemp">
      <view class="lbl">行业温度<text class="q">{{tempOpen ? '收起' : '怎么读 ›'}}</text></view>
      <view class="big" style="color:{{topColor}}">{{d.top}}<text class="u">°</text></view>
      <view class="phase" style="color:{{topColor}}">{{d.phase}} · {{d.stage}}</view>

      <view class="scale" wx:if="{{d.temp_range}}">
        <view class="sbar"><view class="sdot" style="left:{{tempPct}}%;background:{{topColor}}"></view></view>
        <view class="scap">
          <text>历史最低 {{d.temp_range.min}}°</text>
          <text class="muted">越高越接近周期顶部</text>
          <text>最高 {{d.temp_range.max}}°</text>
        </view>
      </view>

      <view class="hint">{{d.stage_desc}}</view>

      <view class="exp" wx:if="{{tempOpen}}">
        <view class="exp-p">温度是五个信号的加权合成分（②⑤两个慢变量已按连续亮灯期数衰减），代表当前离周期顶部的距离。回测 35 期里两轮周期都在 61–62 见顶、21–32 见底，上面那条尺的两端就是这些历史极值。</view>
        <view class="exp-p">方向由相位标签负责。同样是 36°，「扩张期」是在往上爬，「筑底期」是已经跌透——数字相同，含义相反，这也是原先要分两个温度的原因。</view>
        <view class="exp-p">温度峰值比实际周期顶部滞后 1–2 个季度，它描述的是产业当前所处的位置，而非对未来的预判。提前量在主触发器那里：回测两轮各提前 2 个季度，零误报。</view>
        <view class="exp-p muted">另有一个「触底信号」（本期 {{d.bottom}}）回答的是另一个问题——反转条件凑齐了没有。它不是温度的另一端，详见下方指标卡里的说明。</view>
      </view>
    </view>

    <view class="card">
      <view class="row"><text class="k">读数日期</text><text class="v">{{d.updated}}</text></view>
      <view class="row"><text class="k">亮灯计数</text><text class="v">≥50 共 {{d.n50}} 盏 · ≥75 共 {{d.n75}} 盏</text></view>
      <view class="trig" wx:if="{{d.triggers.length}}">
        <view wx:for="{{d.triggers}}" wx:key="*this">⚠ {{item}}</view>
      </view>
      <view class="row" wx:else><text class="k">主触发器</text><text class="v ok">未触发</text></view>

      <view class="row bot" bindtap="toggleBot">
        <text class="k">触底信号</text>
        <text class="v" style="color:{{botColor}}">{{d.bottom}}<text class="q">{{botOpen ? '收起' : '怎么读 ›'}}</text></text>
      </view>

      <view class="exp" wx:if="{{botOpen && d.bottom_explain}}">
        <view class="exp-p">{{d.bottom_explain.what}}</view>
        <view class="exp-p">{{d.bottom_explain.why}}</view>

        <view class="exp-h">四个分项</view>
        <view class="rule {{r.score > 0 ? 'on' : ''}}" wx:for="{{d.bottom_explain.parts}}" wx:key="name" wx:for-item="r">
          <text class="rc">{{r.name}} <text class="w">{{r.weight}}%</text></text><text class="rs">{{r.score}}</text>
        </view>
        <view class="exp-p" wx:for="{{d.bottom_explain.parts}}" wx:key="name" wx:for-item="r">· {{r.name}}：{{r.desc}}</view>

        <view class="exp-h">怎么读</view>
        <view class="exp-p">{{d.bottom_explain.gate}}</view>
        <view class="exp-p" wx:if="{{d.bottom_explain.zero_note}}">{{d.bottom_explain.zero_note}}</view>
        <view class="exp-note">{{d.bottom_explain.example}}</view>
      </view>
    </view>

    <view class="card anchor {{d.equity_anchor.alert ? 'warn' : ''}}">
      <view class="row"><text class="k">市场定价锚 · DRAM</text>
        <text class="v" style="color:{{d.equity_anchor.drawdown_pct <= -25 ? '#dc2626' : '#374151'}}">
          {{d.equity_anchor.drawdown_pct}}%（距高点）</text></view>
      <view class="anote">{{d.equity_anchor.note}}</view>
    </view>

    <view class="card sig" wx:for="{{sig}}" wx:key="id" wx:for-item="s" wx:for-index="i">
      <view class="sig-head" bindtap="toggle" data-i="{{i}}">
        <view class="idx" style="background:{{s.color}}">{{s.id}}</view>
        <view class="st">
          <view class="nm">{{s.name}} <text class="w">{{s.weightPct}}%</text>
            <text wx:if="{{!s.fresh}}" class="stale">本期无新数据</text></view>
          <view class="ld">{{s.lead}}</view>
        </view>
        <view class="val" style="color:{{s.color}}">{{s.score}}</view>
      </view>
      <view class="bar"><view class="fill" style="width:{{s.score}}%;background:{{s.color}}"></view></view>
      <view class="met"><text class="mt">{{s.metricText}}</text><text class="q">{{s.open ? '收起' : '打分逻辑 ›'}}</text></view>

      <view class="exp" wx:if="{{s.open && s.explain}}">
        <view class="exp-h">统计范围与来源</view>
        <view class="exp-p">{{s.explain.range}}</view>

        <view class="exp-h">分档表</view>
        <view class="rule {{r.cond === s.explain.hit ? 'on' : ''}}" wx:for="{{s.explain.rules}}" wx:key="cond" wx:for-item="r">
          <text class="rc">{{r.cond}}</text><text class="rs">{{r.score}}</text>
        </view>

        <block wx:if="{{s.explain.adds.length}}">
          <view class="exp-h">修饰项</view>
          <view class="exp-p" wx:for="{{s.explain.adds}}" wx:key="*this">· {{item}}</view>
        </block>

        <view class="exp-h">本期</view>
        <view class="exp-p">命中「{{s.explain.hit}}」，基础 {{s.explain.base}} 分{{s.explain.base === s.explain.final ? '' : '，修饰后 ' + s.explain.final + ' 分'}}</view>
        <view class="exp-p" wx:if="{{s.explain.next}}">{{s.explain.next}}</view>
        <view class="exp-p" wx:if="{{s.explain.role}}">{{s.explain.role}}</view>
        <view class="exp-note" wx:if="{{s.explain.caveat}}">{{s.explain.caveat}}</view>
      </view>
    </view>

    <view class="card" wx:if="{{d.spot.series.length > 1}}">
      <view class="k" style="margin-bottom:8rpx">现货价走势 · DDR4 1Gx8 3200MT/s</view>
      <canvas type="2d" id="sp" class="chart" bindtouchstart="spotTouch" bindtouchmove="spotTouch"></canvas>
      <view class="tip">{{spotTip || '点按或滑动图上任意位置查看该点读数'}}</view>
      <view class="tip muted">数据源发布的是不定期官方快照，相邻两点间隔 5～140 天不等，横轴按读数序号等距排列，不是按真实时间比例。合约价无公开数据源，故只画现货一条线。</view>
    </view>

    <view class="card">
      <view class="tabs">
        <text class="tab {{tab==='weekly'?'on':''}}" bindtap="switchTab" data-t="weekly">周度实测</text>
        <text class="tab {{tab==='quarterly'?'on':''}}" bindtap="switchTab" data-t="quarterly">季度重建(2018起)</text>
      </view>
      <canvas type="2d" id="ch" class="chart"></canvas>
      <view class="legend"><text style="color:#dc2626">━ 行业温度</text><text style="color:#16a34a">━ 触底信号</text><text class="muted">● 触发点</text></view>
      <view class="tip" wx:if="{{tab==='quarterly'}}">季度序列为历史规则重建，非实测数据，仅供规则验证参考。</view>
    </view>

    <view class="card" wx:if="{{d.sources.length}}">
      <view class="k" style="margin-bottom:10rpx">本期数据来源</view>
      <view class="src" wx:for="{{d.sources}}" wx:key="url" wx:for-item="s">
        <view>🔗 {{s.title}}</view><text class="surl" user-select="{{true}}">{{s.url}}</text>
      </view>
    </view>

    <view class="disc">{{d.disclaimer}}</view>
  </block>
</view>
